// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum BudgetRange {
  UNDER_10K
  RANGE_10K_20K
  RANGE_20K_40K
  RANGE_40K_75K
  RANGE_75K_150K
  OVER_150K
  NOT_SURE
}

enum BoothSizeCode {
  SIZE_10X10
  SIZE_10X20
  SIZE_20X20
  SIZE_20X30
  SIZE_20X40
  SIZE_30X30
  SIZE_40X40_PLUS
  NOT_SURE
}

enum ServiceType {
  BOOTH_RENTAL
  CUSTOM_DESIGN
  FABRICATION
  DISPLAYS
  ISLAND_BOOTHS
  INSTALLATION_DISMANTLING
  GRAPHICS_SIGNAGE
  AV_LED
  FURNITURE
  TURNKEY_SERVICE
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  EITHER
}

enum RFQFileCategory {
  FLOOR_PLAN
  INSPIRATION
  BRAND_GUIDELINES
  OTHER
}

// Scaffolded-only enums, used by future-sprint models below.
enum OpportunityStage {
  MATCHED
  CONTACTED
  QUOTED
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

// ---------------------------------------------------------------------------
// Core domain models (read/written by Sprint 1 code)
// ---------------------------------------------------------------------------

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  state     String
  intro     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]
  events Event[]
  rfqs   RFQ[]

  @@index([state])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  citySlug  String
  city      City     @relation(fields: [citySlug], references: [slug])
  createdAt DateTime @default(now())

  events Event[]

  @@unique([citySlug, name])
  @@index([citySlug])
}

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  overview  String
  citySlug  String?
  city      City?    @relation(fields: [citySlug], references: [slug])
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfqs RFQ[]

  @@index([citySlug])
}

model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  type        ServiceType @unique
  createdAt   DateTime    @default(now())

  rfqServices RFQService[]
}

model BoothSize {
  id        String        @id @default(cuid())
  code      BoothSizeCode @unique
  label     String
  sortOrder Int

  rfqs RFQ[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  industry  String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfqs RFQ[]

  @@index([name])
}

model RFQ {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Step 1: Event
  eventId           String?
  event             Event?   @relation(fields: [eventId], references: [id])
  eventNameFreeText String?
  citySlug          String?
  city              City?    @relation(fields: [citySlug], references: [slug])
  venueFreeText     String?
  eventDate         DateTime?
  eventUnknown      Boolean  @default(false)

  // Step 2: Booth
  boothSizeId   String?
  boothSize     BoothSize?     @relation(fields: [boothSizeId], references: [id])
  boothSizeCode BoothSizeCode?

  // Step 4: Budget
  budgetRange BudgetRange?

  // Step 5: Project details
  projectDescription String?

  // Step 6: Company
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Step 7: Contact
  firstName        String
  lastName          String
  email             String
  phone             String?
  preferredContact  PreferredContactMethod @default(EMAIL)

  status      LeadStatus @default(NEW)
  landingPage String?

  services       RFQService[]
  files          RFQFile[]
  attribution    Attribution?
  leadScore      LeadScore?
  builderMatches BuilderMatch[]
  opportunities  Opportunity[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([citySlug])
}

model RFQService {
  id        String  @id @default(cuid())
  rfqId     String
  rfq       RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([rfqId, serviceId])
}

model RFQFile {
  id        String          @id @default(cuid())
  rfqId     String
  rfq       RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category  RFQFileCategory
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime        @default(now())

  @@index([rfqId])
}

model Attribution {
  id          String   @id @default(cuid())
  rfqId       String   @unique
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  landingPage String?
  createdAt   DateTime @default(now())
}

model LeadScore {
  id        String   @id @default(cuid())
  rfqId     String   @unique
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  score     Int
  tier      String
  breakdown Json
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Scaffolded models — future sprints (admin, builder portal, matching,
// quotes/projects/commissions). Not written to by Sprint 1 code, but shaped
// now so later sprints are additive migrations rather than schema rewrites.
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builder        Builder?
  adminNotes     AdminNote[]
  communications Communication[]
}

model Builder {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  companyName String
  website     String?
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations     BuilderLocation[]
  capabilities  BuilderCapability[]
  portfolio     BuilderPortfolio[]
  matches       BuilderMatch[]
  opportunities Opportunity[]
  quotes        Quote[]
  projects      Project[]
  commissions   Commission[]
  reviews       Review[]
}

model BuilderLocation {
  id        String  @id @default(cuid())
  builderId String
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  citySlug  String

  @@unique([builderId, citySlug])
}

model BuilderCapability {
  id          String      @id @default(cuid())
  builderId   String
  builder     Builder     @relation(fields: [builderId], references: [id], onDelete: Cascade)
  serviceType ServiceType

  @@unique([builderId, serviceType])
}

model BuilderPortfolio {
  id        String  @id @default(cuid())
  builderId String
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
}

model BuilderMatch {
  id         String   @id @default(cuid())
  rfqId      String
  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  builderId  String
  builder    Builder  @relation(fields: [builderId], references: [id])
  matchScore Int?
  createdAt  DateTime @default(now())

  @@unique([rfqId, builderId])
}

model Opportunity {
  id        String           @id @default(cuid())
  rfqId     String
  rfq       RFQ              @relation(fields: [rfqId], references: [id])
  builderId String
  builder   Builder          @relation(fields: [builderId], references: [id])
  stage     OpportunityStage @default(MATCHED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  quotes     Quote[]
  project    Project?
  commission Commission?
}

model Quote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  builderId     String
  builder       Builder     @relation(fields: [builderId], references: [id])
  status        QuoteStatus @default(DRAFT)
  totalAmount   Decimal?    @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  items QuoteItem[]
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(12, 2)
}

model Project {
  id            String        @id @default(cuid())
  opportunityId String        @unique
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id])
  builderId     String
  builder       Builder       @relation(fields: [builderId], references: [id])
  status        ProjectStatus @default(PLANNED)
  createdAt     DateTime      @default(now())
}

model Commission {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  builderId     String
  builder       Builder     @relation(fields: [builderId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  paid          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Review {
  id        String   @id @default(cuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Communication {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rfqId     String?
  channel   String
  body      String?
  createdAt DateTime @default(now())
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rfqId     String?
  note      String
  createdAt DateTime @default(now())
}
